generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Vendor {
  AMD
  INTEL
  NVIDIA
}

enum ComponentTier {
  ENTRY
  MID
  HIGH
  ULTRA
  ENTHUSIAST
}

model Cpu {
  id              String        @id @default(cuid())
  vendor          Vendor
  modelName       String        @unique
  cores           Int
  threads         Int
  baseClockGhz    Float
  boostClockGhz   Float
  socket          String?
  tier            ComponentTier
  singleCoreScore Int?
  multiCoreScore  Int?
  retailLinks     RetailLink[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Gpu {
  id              String        @id @default(cuid())
  vendor          Vendor
  modelName       String        @unique
  vramGb          Int
  memoryType      String?
  architecture    String?
  tier            ComponentTier
  rasterScore     Int?
  retailLinks     RetailLink[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model RetailLink {
  id           String   @id @default(cuid())
  asin         String   @unique
  retailTitle  String
  currentPrice Float?
  currency     String   @default("EUR")
  cpuId        String?
  cpu          Cpu?     @relation(fields: [cpuId], references: [id], onDelete: Cascade)
  gpuId        String?
  gpu          Gpu?     @relation(fields: [gpuId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([cpuId])
  @@index([gpuId])
}
