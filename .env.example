# PostgreSQL — local dev
DATABASE_URL="postgresql://hardwarestack:hardwarestack@localhost:5432/hardwarestack"

# Production database — set these to your production Postgres credentials
# DATABASE_URL is the pooled connection string (used by the app at runtime)
# DIRECT_URL is the direct connection string (used by Prisma migrations, bypasses connection poolers)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required by scripts/db-push-to-prod.sh
PROD_DB_PASSWORD=""

# Claude API key — used by the scraper pipeline only (never exposed to the browser)
ANTHROPIC_API_KEY="sk-ant-..."

# Secret for POST /api/revalidate cache invalidation
REVALIDATE_TOKEN=""
