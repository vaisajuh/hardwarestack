# PostgreSQL — local dev
DATABASE_URL="postgresql://hardwarestack:hardwarestack@localhost:5432/hardwarestack"

# Neon production credentials (used by scripts/migrate-to-neon.sh and db-push-to-prod.sh)
# Get both strings from: Neon dashboard → your project → Connection Details
NEON_DIRECT_URL="postgresql://neondb_owner:...@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
NEON_POOL_URL="postgresql://neondb_owner:...@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
PROD_DB_PASSWORD=""

# Amazon Associates affiliate tag
NEXT_PUBLIC_AMAZON_AFFILIATE_TAG="hardwarestack-21"

# Claude API key — used by the scraper pipeline only (never exposed to the browser)
ANTHROPIC_API_KEY="sk-ant-..."
